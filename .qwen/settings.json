{
  "mcpServers": {
    "athena-mcp": {
      "command": "uv",
      "args": [
        "--directory",
        "${workspaceRoot}/athena_mcp",
        "run",
        "python",
        "main.py"
      ],
      "env": {
        "ATHENA_BACKEND_URL": "http://localhost:8000",
        "ATHENA_FRONTEND_PORT": "5173"
      }
    },
    "shopee-mcp": {
      "command": "uv",
      "args": [
        "--directory",
        "${workspaceRoot}/shopee_mcp",
        "run",
        "python",
        "main.py"
      ],
      "env": {
        "ATHENA_BACKEND_URL": "http://localhost:8000",
        "SHOPEE_MERCHANT_ID": "ShopeeDummyMerchant"
      }
    }
  },
  "$version": 3
}
